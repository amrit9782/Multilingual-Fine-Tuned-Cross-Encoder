# HuggingFace access token (https://huggingface.co/settings/tokens)
# Copy this file to .env and fill in your values.
# Keep this file accurate — it tells the evaluator which variables your solution needs.
# Do NOT commit .env to git.

# Add every environment variable your solution reads from os.environ below.
# Example:
# HF_TOKEN=

HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Model to use (choose one):
# Recommended model (v11-base)
MODEL_PATH=amrit97/xlm-roberta-base-grader-v11
MODEL_REPO=amrit97/xlm-roberta-base-grader-v11
FIELD_COLS=rubric,answer
USE_PREFIX=false
T_BINARY=0.5
T1_TERNARY=0.22
T2_TERNARY=0.69

# Alternative: v11-large is heavier but gives identical results
# MODEL_REPO=amrit97/xlm-roberta-large-grader-v11
# FIELD_COLS=rubric,answer
# USE_PREFIX=false
# T_BINARY=0.5
# T1_TERNARY=0.22
# T2_TERNARY=0.69

# Alternative: v10-large: best CV RMSE=0.2549, but weaker on ternary rubrics
# MODEL_REPO=jan024/asag-xlm-roberta-large-v10
# FIELD_COLS=rubric,question,answer
# USE_PREFIX=true
# T_BINARY=0.33
# T1_TERNARY=0.30
# T2_TERNARY=0.70
